{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    // 配列・オブジェクトの添字アクセスを `T | undefined` として扱う(ヘッダやクエリの取りこぼしを型で拾う)
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // `node src/jwt.ts` のように Node で直接実行できるようにする
    // (import に `.ts` を書けるようにし、Node が消せない構文(enum など)を禁止する)
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
